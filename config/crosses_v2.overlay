/* config/crosses.overlay */

#define MOUSE_LAYER_INDEX 7

/ {
    behaviors {
        /* 
           1. Create the momentary swap state logic.
           - On Press: Switches Left to Pointer (0), Right to Scroll (1), activates Layer.
           - On Release: Taps Left to Scroll (1), Right to Pointer (0), deactivates Layer.
        */
        tb_momentary_swap: tb_momentary_swap {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings 
                = <&pipe_switch 0 0>           // Press 1: Left -> Pointer
                , <&pipe_switch_r 1 0>         // Press 2: Right -> Scroll Up
                , <&mo MOUSE_LAYER_INDEX>      // Press 3: Turn on Mouse Layer
                , <&pipe_switch 1 0>           // Release 1: Left back to Scroll Up
                , <&pipe_switch_r 0 0>         // Release 2: Right back to Pointer
                ;
        };

        /* 
           2. Wrap it inside a normal hold-tap behavior.
           - Hold: Fires our Tri-State macro wrapper.
           - Tap: Outputs your clean alpha keypress code.
        */
        z_tb_swap: z_tb_swap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";         
            tapping-term-ms = <200>;           
            bindings = <&tb_momentary_swap>, <&kp>;
        };
    };
};
