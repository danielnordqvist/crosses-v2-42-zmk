/* config/crosses.overlay */

/* Define your Mouse Layer index number here */
#define MOUSE_LAYER_INDEX 7

/ {
    behaviors {
        /*
           Create a simple hold-tap key:
           - Hold: Momentarily switch to the Mouse Layer
           - Tap: Outputs your standard alpha key (e.g., Z)
        */
        z_tb_swap: z_tb_swap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";         
            tapping-term-ms = <200>;           
            bindings = <&mo>, <&kp>; // Hold activates &mo (Layer), Tap activates &kp
        };
    };

    /* ==============================================================
       USE THE DEFINED TRACKBALL LISTENERS AS LAYER EVENT SENSORS
       ============================================================== */
    /* 
       We target the pre-existing trackball listeners and tell them to 
       dynamically look at our Mouse Layer index!
    */
    &left_trackball_listener {
        scroller {
            layers = <MOUSE_LAYER_INDEX>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    &right_trackball_listener {
        scroller {
            layers = <MOUSE_LAYER_INDEX>;
            // Empty input-processor forces standard pointer passthrough instead of scroll 
            // when this specific layer becomes active.
            input-processors = <>; 
        };
    };
};
